# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_ID=       # your personal chat ID for error alerts

# ─── OKX API ─────────────────────────────────────────────────────────────────
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_DEMO=false           # true adds x-simulated-trading: 1 to OKX requests
OKX_SIMULATED=false      # alias for OKX_DEMO

# ─── Trading Mode ────────────────────────────────────────────────────────────
# Real OKX market data + internal paper trading + no real orders:
TRADING_MODE=paper
AUTO_TRADE=false
PAPER_START_BALANCE=1000  # trading balance used for risk, sizing, PnL and limits in paper mode

# Future live trading:
# TRADING_MODE=live
# AUTO_TRADE=true

# ─── Instruments & Timeframes ────────────────────────────────────────────────
SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP,SOL-USDT-SWAP
TIMEFRAMES=15m,1H,4H

# ─── Risk Management ─────────────────────────────────────────────────────────
RISK_GUARD_ENABLED=true   # count risk limits and warnings
AUTO_PAUSE_ON_LIMIT=false # pause only when true; otherwise warn and continue
RISK_PER_TRADE=1          # % of account per trade
MAX_DAILY_LOSS=3          # % daily loss limit
MAX_OPEN_POSITIONS=3
MAX_LOSS_STREAK=3         # consecutive losses limit
MAX_LOSSES_IN_ROW=3       # legacy alias

# ─── Strategy ────────────────────────────────────────────────────────────────
AUTO_OPTIMIZE=false       # apply learning recommendations automatically
MIN_SIGNAL_CONFIDENCE=6   # 1-10, minimum to publish signal

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=./trading.db

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
